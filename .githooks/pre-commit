#!/usr/bin/env bash
# Reject a commit whose staged content looks like a credential.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass deliberately (rare):  git commit --no-verify
#
# This file is excluded from its own scan, because it necessarily contains the
# patterns it looks for.
set -euo pipefail

PATTERNS='(sk-[A-Za-z0-9]{10,}|sk-ant-[A-Za-z0-9_-]{10,}|sk-proj-[A-Za-z0-9_-]{10,}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|ghu_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|oc_sk_[A-Za-z0-9_-]{10,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{12,}|-----BEGIN [A-Z ]*PRIVATE KEY|Bearer [A-Za-z0-9._-]{20,}|(password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,})'

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '^\.githooks/' || true)
[ -z "$FILES" ] && exit 0

HITS=""
for f in $FILES; do
  [ -f "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.jpeg|*.webp|*.gif|*.pdf|*.zip|*.gz) continue ;;
  esac
  # Scan the staged blob, not the working tree, so a partially staged file is judged on what ships.
  if git show ":$f" 2>/dev/null | grep -nEI "$PATTERNS" >/dev/null 2>&1; then
    HITS="$HITS$f"$'\n'"$(git show ":$f" | grep -nEI "$PATTERNS" | head -3)"$'\n'
  fi
done

if [ -n "$HITS" ]; then
  echo "✖ pre-commit: staged content looks like a credential — commit blocked." >&2
  echo "$HITS" >&2
  echo "  Fix the file, or if it is a false positive: git commit --no-verify" >&2
  exit 1
fi
exit 0
